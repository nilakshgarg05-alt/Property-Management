<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="630.0" prefWidth="680.0"
            style="-fx-background-color: #f4f7ff;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.customercontroller">
   <children>

      <!-- Top accent bar -->
      <Rectangle layoutX="0" layoutY="0" width="680" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

      <!-- White header panel -->
      <Rectangle layoutX="0" layoutY="5" width="680" height="58"
                 fill="#ffffff" />
      <Rectangle layoutX="0" layoutY="62" width="680" height="2"
                 fill="linear-gradient(to bottom, #d0ddf5, transparent)" />

      <!-- Header title -->
      <Label layoutX="240.0" layoutY="18.0" text="&#128100;  Customer Master"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 19px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

      <!-- Search bar row - white card -->
      <Rectangle layoutX="14.0" layoutY="74.0" width="652.0" height="56.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Label layoutX="28.0" layoutY="83.0" text="Mobile Search:"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 11px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtMob" layoutX="140.0" layoutY="82.0" prefHeight="36.0" prefWidth="165.0"
                 promptText="Mobile number"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>
      <Button layoutX="316.0" layoutY="82.0" mnemonicParsing="false" onAction="#onSearch" text="&#128269;  Search"
              prefHeight="36.0" prefWidth="110.0"
              style="-fx-background-color: #1a6dd4; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
      <Label layoutX="454.0" layoutY="83.0" text="Customer Type:"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 11px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <ComboBox fx:id="combotype" layoutX="556.0" layoutY="82.0" prefWidth="100.0" prefHeight="36.0"
                style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

      <!-- Section label - Customer Details -->
      <Label layoutX="20.0" layoutY="146.0" text="Customer Details"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <Rectangle layoutX="164.0" layoutY="158.0" width="500.0" height="2" fill="#1a6dd430" />

      <!-- White form card -->
      <Rectangle layoutX="14.0" layoutY="165.0" width="652.0" height="118.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />

      <!-- Name -->
      <Label layoutX="28.0" layoutY="176.0" text="Full Name"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtName" layoutX="28.0" layoutY="192.0" prefHeight="36.0" prefWidth="185.0"
                 promptText="Full name"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Address -->
      <Label layoutX="230.0" layoutY="176.0" text="Address"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtAddr" layoutX="230.0" layoutY="192.0" prefHeight="36.0" prefWidth="420.0"
                 promptText="Full address"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- City -->
      <Label layoutX="28.0" layoutY="240.0" text="City"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtCity" layoutX="28.0" layoutY="256.0" prefHeight="36.0" prefWidth="185.0"
                 promptText="City"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Email -->
      <Label layoutX="230.0" layoutY="240.0" text="Email ID"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtMail" layoutX="230.0" layoutY="256.0" prefHeight="36.0" prefWidth="420.0"
                 promptText="Email address"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Section label - Documents & Photos -->
      <Label layoutX="20.0" layoutY="310.0" text="Documents &amp; Photos"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <Rectangle layoutX="220.0" layoutY="322.0" width="444.0" height="2" fill="#1a6dd430" />

      <!-- Photos card -->
      <Rectangle layoutX="14.0" layoutY="330.0" width="652.0" height="166.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />

      <!-- Customer Picture -->
      <Label layoutX="28.0" layoutY="342.0" text="Customer Photo"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <StackPane layoutX="28.0" layoutY="358.0" prefHeight="100.0" prefWidth="162.0"
                 style="-fx-background-color: #f0f4ff; -fx-border-color: #c5d5f5; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;">
         <children>
            <ImageView fx:id="prev1" fitHeight="90.0" fitWidth="154.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <Button layoutX="38.0" layoutY="466.0" mnemonicParsing="false" onAction="#onBrowse1" text="&#128193;  Browse"
              prefHeight="28.0" prefWidth="142.0"
              style="-fx-background-color: #f0f4ff; -fx-text-fill: #1a6dd4; -fx-font-size: 11px; -fx-font-family: 'Segoe UI'; -fx-border-color: #1a6dd4; -fx-border-width: 1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <!-- Aadhar Picture -->
      <Label layoutX="230.0" layoutY="342.0" text="Aadharcard Photo"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 10px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <StackPane layoutX="230.0" layoutY="358.0" prefHeight="100.0" prefWidth="162.0"
                 style="-fx-background-color: #f0f4ff; -fx-border-color: #c5d5f5; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;">
         <children>
            <ImageView fx:id="prev2" fitHeight="90.0" fitWidth="154.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <Button layoutX="240.0" layoutY="466.0" mnemonicParsing="false" onAction="#onBrowse2" text="&#128193;  Browse"
              prefHeight="28.0" prefWidth="142.0"
              style="-fx-background-color: #f0f4ff; -fx-text-fill: #1a6dd4; -fx-font-size: 11px; -fx-font-family: 'Segoe UI'; -fx-border-color: #1a6dd4; -fx-border-width: 1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <!-- Register Face -->
      <Button text="&#127917;  Register Face" onAction="#doRegisterFace"
              layoutX="440.0" layoutY="390.0" prefWidth="200.0" prefHeight="40.0"
              style="-fx-background-color: linear-gradient(to right, #1a6dd4, #2e87f0); -fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 9; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <!-- Action Buttons row -->
      <Rectangle layoutX="14.0" layoutY="508.0" width="652.0" height="2" fill="#e0e8f5" />

      <Rectangle layoutX="14.0" layoutY="518.0" width="652.0" height="66.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />

      <Button layoutX="28.0" layoutY="532.0" mnemonicParsing="false" onAction="#onSave"
              text="&#128190;  Save" prefHeight="38.0" prefWidth="120.0"
              style="-fx-background-color: #0d9e5c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-background-radius: 9; -fx-cursor: hand;"/>
      <Button layoutX="162.0" layoutY="532.0" mnemonicParsing="false" onAction="#onUpdate"
              text="&#9999;  Update" prefHeight="38.0" prefWidth="120.0"
              style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-background-radius: 9; -fx-cursor: hand;"/>
      <Button layoutX="296.0" layoutY="532.0" mnemonicParsing="false" onAction="#onDelete"
              text="&#128465;  Delete" prefHeight="38.0" prefWidth="120.0"
              style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-background-radius: 9; -fx-cursor: hand;"/>
      <Button layoutX="430.0" layoutY="532.0" mnemonicParsing="false" onAction="#onClear"
              text="&#8635;  Clear" prefHeight="38.0" prefWidth="120.0"
              style="-fx-background-color: #f0f4ff; -fx-text-fill: #6b7a99; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-border-color: #d0ddf5; -fx-border-width: 1; -fx-border-radius: 9; -fx-background-radius: 9; -fx-cursor: hand;"/>

      <!-- Bottom accent bar -->
      <Rectangle layoutX="0" layoutY="625" width="680" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

   </children>
</AnchorPane>
