<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="600.0" prefWidth="740.0"
            style="-fx-background-color: #f4f7ff;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.CameraController">

    <children>

        <!-- Top accent bar -->
        <Rectangle layoutX="0" layoutY="0" width="740" height="5"
                   fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

        <!-- White header panel -->
        <Rectangle layoutX="0" layoutY="5" width="740" height="52"
                   fill="#ffffff" />
        <Rectangle layoutX="0" layoutY="56" width="740" height="2"
                   fill="linear-gradient(to bottom, #d0ddf5, transparent)" />
        <Label layoutX="278.0" layoutY="14.0" text="&#128247;  Camera Capture"
               style="-fx-text-fill: #1a3a6e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

        <!-- Camera view card -->
        <Rectangle layoutX="35.0" layoutY="66.0" width="670.0" height="492.0" arcWidth="14" arcHeight="14"
                   fill="#ffffff" />
        <Rectangle layoutX="35.0" layoutY="66.0" width="670.0" height="4" arcWidth="14" arcHeight="14"
                   fill="#1a6dd4" />

        <!-- Camera view -->
        <ImageView fx:id="cameraView"
                   fitWidth="660"
                   fitHeight="480"
                   layoutX="40"
                   layoutY="72"
                   preserveRatio="true"/>

        <!-- Bottom control bar -->
        <Rectangle layoutX="35.0" layoutY="540.0" width="670.0" height="52.0" arcWidth="10" arcHeight="10"
                   fill="#f0f4ff" />
        <Rectangle layoutX="35.0" layoutY="540.0" width="670.0" height="1.5"
                   fill="#d0ddf5" />

        <Label layoutX="50" layoutY="554" text="Person Name:"
               style="-fx-text-fill: #6b7a99; -fx-font-size: 11px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>

        <TextField fx:id="txtPerson"
                   layoutX="152"
                   layoutY="551"
                   prefWidth="230"
                   prefHeight="36"
                   promptText="Enter name..."
                   style="-fx-background-color: #ffffff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

        <Button text="&#128248;  Capture Face"
                layoutX="406"
                layoutY="551"
                prefHeight="36"
                prefWidth="168"
                onAction="#captureFace"
                style="-fx-background-color: #1a6dd4; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <!-- Bottom accent bar -->
        <Rectangle layoutX="0" layoutY="595" width="740" height="5"
                   fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

    </children>

</AnchorPane>
