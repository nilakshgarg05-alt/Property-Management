<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="620.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f0f4ff, #e8edf8, #f5f7ff);"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.username">
   <children>

      <!-- Top accent bar -->
      <Rectangle layoutX="0" layoutY="0" width="620" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

      <!-- Left branding panel -->
      <Rectangle layoutX="0" layoutY="5" width="210" height="555"
                 fill="linear-gradient(to bottom, #1a3a6e, #1f4d9a, #1a6dd4)" />

      <!-- Logo area -->
      <ImageView fitHeight="110.0" fitWidth="110.0" layoutX="50.0" layoutY="80.0" preserveRatio="true">
         <image>
            <Image url="@../customer/logo.png" />
         </image>
      </ImageView>

      <!-- Brand text on left -->
      <Label layoutX="20.0" layoutY="205.0" text="Shree Bala Ji"
             style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" prefWidth="170" wrapText="true"/>
      <Label layoutX="20.0" layoutY="234.0" text="Property Management System"
             style="-fx-text-fill: #a8c8ff; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" prefWidth="170" wrapText="true"/>

      <!-- Decorative separator on left panel -->
      <Rectangle layoutX="25.0" layoutY="265.0" width="160.0" height="1" fill="#ffffff30" />

      <Label layoutX="20.0" layoutY="280.0" text="&#x2713;  Secure Login"
             style="-fx-text-fill: #c0deff; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
      <Label layoutX="20.0" layoutY="305.0" text="&#x2713;  Face Recognition"
             style="-fx-text-fill: #c0deff; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />
      <Label layoutX="20.0" layoutY="330.0" text="&#x2713;  Real-Time Data"
             style="-fx-text-fill: #c0deff; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" />

      <!-- Right login card area -->
      <!-- Card background -->
      <Rectangle layoutX="225.0" layoutY="50.0" width="368.0" height="460.0" arcWidth="18" arcHeight="18"
                 fill="#ffffff" />
      <!-- Card shadow effect -->
      <Rectangle layoutX="228.0" layoutY="53.0" width="368.0" height="460.0" arcWidth="18" arcHeight="18"
                 fill="#00000010" />
      <Rectangle layoutX="225.0" layoutY="50.0" width="368.0" height="460.0" arcWidth="18" arcHeight="18"
                 fill="#ffffff" />

      <!-- Card top blue line -->
      <Rectangle layoutX="225.0" layoutY="50.0" width="368.0" height="4" arcWidth="18" arcHeight="18"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff)" />

      <!-- Welcome heading -->
      <Label layoutX="270.0" layoutY="80.0" text="Welcome Back"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <Label layoutX="270.0" layoutY="112.0" text="Sign in to your account"
             style="-fx-text-fill: #7a8fa6; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"/>

      <!-- Divider -->
      <Rectangle layoutX="248.0" layoutY="140.0" width="322.0" height="1" fill="#e8ecf0" />

      <!-- Username field -->
      <Label layoutX="248.0" layoutY="158.0" text="USERNAME"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 0.5px;"/>
      <TextField fx:id="txtusername" layoutX="248.0" layoutY="175.0" prefHeight="40.0" prefWidth="322.0"
                 promptText="Enter your username"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Password field -->
      <Label layoutX="248.0" layoutY="230.0" text="PASSWORD"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <TextField fx:id="txtpassword" layoutX="248.0" layoutY="248.0" prefHeight="40.0" prefWidth="322.0"
                 promptText="Enter your password"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Sign In Button -->
      <Button layoutX="248.0" layoutY="316.0" mnemonicParsing="false" onAction="#dologin"
              text="SIGN IN" prefHeight="44.0" prefWidth="322.0"
              style="-fx-background-color: linear-gradient(to right, #1a6dd4, #2e87f0); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-background-radius: 10; -fx-cursor: hand;"/>

      <!-- Separator -->
      <Rectangle layoutX="248.0" layoutY="378.0" width="140.0" height="1" fill="#e8ecf0" />
      <Label layoutX="393.0" layoutY="369.0" text="OR"
             style="-fx-text-fill: #aab4c0; -fx-font-size: 11px; -fx-background-color: #ffffff; -fx-padding: 0 8;"/>
      <Rectangle layoutX="428.0" layoutY="378.0" width="142.0" height="1" fill="#e8ecf0" />

      <!-- Camera + Face Login buttons -->
      <Button layoutX="248.0" layoutY="396.0" mnemonicParsing="false" onAction="#doopencam"
              text="&#128247;  Open Camera" prefHeight="40.0" prefWidth="154.0"
              style="-fx-background-color: #f0f6ff; -fx-text-fill: #1a6dd4; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-border-color: #1a6dd4; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
      <Button layoutX="416.0" layoutY="396.0" mnemonicParsing="false" onAction="#facelogin"
              text="&#128269;  Face Login" prefHeight="40.0" prefWidth="154.0"
              style="-fx-background-color: #f0f6ff; -fx-text-fill: #1a6dd4; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-border-color: #1a6dd4; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <!-- Footer text -->
      <Label layoutX="248.0" layoutY="452.0" text="&#169; 2025 Shree Bala Ji Property Management"
             style="-fx-text-fill: #b0bec5; -fx-font-size: 10px; -fx-font-family: 'Segoe UI';" prefWidth="322"/>

      <!-- Bottom accent bar -->
      <Rectangle layoutX="0" layoutY="555" width="620" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

   </children>
</AnchorPane>
