<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="460.0" prefWidth="660.0"
            style="-fx-background-color: #f4f7ff;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.analyticscontroller">
   <children>

      <!-- Top accent bar -->
      <Rectangle layoutX="0" layoutY="0" width="660" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

      <!-- White header panel -->
      <Rectangle layoutX="0" layoutY="5" width="660" height="52"
                 fill="#ffffff" />
      <Rectangle layoutX="0" layoutY="56" width="660" height="2"
                 fill="linear-gradient(to bottom, #d0ddf5, transparent)" />
      <!-- Logo in navbar -->
      <ImageView fitHeight="36.0" fitWidth="36.0" layoutX="12.0" layoutY="13.0" preserveRatio="true">
         <image><Image url="@../customer/logo.png" /></image>
      </ImageView>
      <Label layoutX="56.0" layoutY="13.0" text="Shree Bala Ji"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <Label layoutX="56.0" layoutY="33.0" text="Property Management"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 9px; -fx-font-family: 'Segoe UI';"/>

      <Label layoutX="240.0" layoutY="14.0" text="&#128202;  Analytics Overview"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

      <!-- Chart cards row 1 -->

      <!-- Chart: Customers - Top Left -->
      <Rectangle layoutX="14.0" layoutY="66.0" width="306.0" height="184.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Rectangle layoutX="14.0" layoutY="66.0" width="306.0" height="4" arcWidth="12" arcHeight="12"
                 fill="#1a6dd4" />
      <Label layoutX="100.0" layoutY="74.0" text="Customer Breakdown"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <PieChart fx:id="customerChart" layoutX="22.0" layoutY="86.0" prefHeight="157.0" prefWidth="290.0"
                style="-fx-background-color: transparent;"/>

      <!-- Chart: Properties - Top Right -->
      <Rectangle layoutX="340.0" layoutY="66.0" width="306.0" height="184.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Rectangle layoutX="340.0" layoutY="66.0" width="306.0" height="4" arcWidth="12" arcHeight="12"
                 fill="#0d9e5c" />
      <Label layoutX="424.0" layoutY="74.0" text="Property Types"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <PieChart fx:id="propertyChart" layoutX="348.0" layoutY="86.0" prefHeight="157.0" prefWidth="290.0"
                style="-fx-background-color: transparent;"/>

      <!-- Chart: Construction - Bottom Left -->
      <Rectangle layoutX="14.0" layoutY="264.0" width="306.0" height="184.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Rectangle layoutX="14.0" layoutY="264.0" width="306.0" height="4" arcWidth="12" arcHeight="12"
                 fill="#e67e22" />
      <Label layoutX="98.0" layoutY="272.0" text="Construction Types"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <PieChart fx:id="constructionChart" layoutX="22.0" layoutY="284.0" prefHeight="157.0" prefWidth="290.0"
                style="-fx-background-color: transparent;"/>

      <!-- Chart: Deals - Bottom Right -->
      <Rectangle layoutX="340.0" layoutY="264.0" width="306.0" height="184.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Rectangle layoutX="340.0" layoutY="264.0" width="306.0" height="4" arcWidth="12" arcHeight="12"
                 fill="#8e44ad" />
      <Label layoutX="432.0" layoutY="272.0" text="Deal Status"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <PieChart fx:id="dealChart" layoutX="348.0" layoutY="284.0" prefHeight="157.0" prefWidth="290.0"
                style="-fx-background-color: transparent;"/>

      <!-- Bottom accent bar -->
      <Rectangle layoutX="0" layoutY="455" width="660" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

   </children>
</AnchorPane>
