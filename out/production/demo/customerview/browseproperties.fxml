<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="460.0" prefWidth="760.0"
            style="-fx-background-color: #f4f7ff;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.browsepropertiescontroller">
   <children>

      <!-- Top accent bar -->
      <Rectangle layoutX="0" layoutY="0" width="760" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

      <!-- White header panel -->
      <Rectangle layoutX="0" layoutY="5" width="760" height="52"
                 fill="#ffffff" />
      <Rectangle layoutX="0" layoutY="56" width="760" height="2"
                 fill="linear-gradient(to bottom, #d0ddf5, transparent)" />
      <!-- Logo in navbar -->
      <ImageView fitHeight="36.0" fitWidth="36.0" layoutX="12.0" layoutY="13.0" preserveRatio="true">
         <image><Image url="@../customer/logo.png" /></image>
      </ImageView>
      <Label layoutX="56.0" layoutY="13.0" text="Shree Bala Ji"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
      <Label layoutX="56.0" layoutY="33.0" text="Property Management"
             style="-fx-text-fill: #6b7a99; -fx-font-size: 9px; -fx-font-family: 'Segoe UI';"/>

      <Label layoutX="270.0" layoutY="14.0" text="&#127960;  Property Catalog"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

      <!-- Filter Card -->
      <Rectangle layoutX="14.0" layoutY="66.0" width="732.0" height="120.0" arcWidth="12" arcHeight="12"
                 fill="#ffffff" />
      <Rectangle layoutX="14.0" layoutY="66.0" width="732.0" height="4" arcWidth="12" arcHeight="12"
                 fill="#1a6dd4" />

      <!-- Filter Row 1 -->
      <Label layoutX="28.0" layoutY="80.0" text="PROPERTY TYPE"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <ComboBox fx:id="comboprop" layoutX="28.0" layoutY="96.0" prefHeight="34.0" prefWidth="148.0"
                style="-fx-background-color: #f5f8ff; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8;"/>

      <Label layoutX="192.0" layoutY="80.0" text="CONSTRUCTION TYPE"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <ComboBox fx:id="combocons" layoutX="192.0" layoutY="96.0" prefHeight="34.0" prefWidth="148.0"
                style="-fx-background-color: #f5f8ff; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8;"/>

      <Button layoutX="360.0" layoutY="88.0" mnemonicParsing="false" onAction="#onshowprop"
              text="&#127968;  Show Properties" prefHeight="40.0" prefWidth="168.0"
              style="-fx-background-color: #1a6dd4; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <Button layoutX="546.0" layoutY="88.0" mnemonicParsing="false" onAction="#ongenpdf"
              text="&#128196;  Generate PDF" prefHeight="40.0" prefWidth="168.0"
              style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

      <!-- Filter Row 2 -->
      <Label layoutX="28.0" layoutY="142.0" text="CITY"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <ComboBox fx:id="combocity" layoutX="28.0" layoutY="156.0" prefHeight="34.0" prefWidth="148.0"
                style="-fx-background-color: #f5f8ff; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8;"/>

      <Label layoutX="192.0" layoutY="142.0" text="AREA"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <ComboBox fx:id="comboarea" layoutX="192.0" layoutY="156.0" prefHeight="34.0" prefWidth="148.0"
                style="-fx-background-color: #f5f8ff; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8;"/>

      <Label layoutX="360.0" layoutY="142.0" text="MIN PRICE (&#8377;)"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtmin" layoutX="360.0" layoutY="156.0" prefHeight="34.0" prefWidth="140.0"
                 promptText="Min &#8377;"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <Label layoutX="516.0" layoutY="142.0" text="MAX PRICE (&#8377;)"
             style="-fx-text-fill: #1a6dd4; -fx-font-size: 9px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>
      <TextField fx:id="txtmax" layoutX="516.0" layoutY="156.0" prefHeight="34.0" prefWidth="140.0"
                 promptText="Max &#8377;"
                 style="-fx-background-color: #f5f8ff; -fx-text-fill: #2d3748; -fx-border-color: #d0dff5; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-prompt-text-fill: #b0bec5;"/>

      <!-- Results section -->
      <Label layoutX="14.0" layoutY="198.0" text="Search Results"
             style="-fx-text-fill: #1a3a6e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

      <!-- Table -->
      <TableView fx:id="propertytable" layoutX="14.0" layoutY="218.0" prefHeight="222.0" prefWidth="732.0"
                 style="-fx-background-color: #ffffff; -fx-border-color: #d0ddf5; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-table-cell-border-color: #e8edf5;"/>

      <!-- Bottom accent bar -->
      <Rectangle layoutX="0" layoutY="455" width="760" height="5"
                 fill="linear-gradient(to right, #1a6dd4, #4a9eff, #1a6dd4)" />

   </children>
</AnchorPane>
